@using System.Globalization
@model MonthlySummary
@{
    ViewData["Title"] = "Resumen mensual";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Resumen mensual</h2>

    <!-- Selector de mes -->
    <form asp-action="Summary" method="get" class="d-flex gap-2">
        <input type="month" name="month" value="@Model.MonthValue" class="form-control" />
        <button type="submit" class="btn btn-outline-secondary">Ver</button>
    </form>
</div>

<h4 class="mb-3 text-capitalize">@Model.MonthLabel</h4>

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Total gastado</div>
                <div class="fs-3 fw-bold">$@Model.TotalAmount.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Cantidad de gastos</div>
                <div class="fs-3 fw-bold">@Model.ExpenseCount</div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Categories.Any())
{
    <p class="text-muted">No hay gastos registrados en este mes.</p>
}
else
{
    <h5 class="mb-3">Gastos por categoría</h5>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Categoría</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">%</th>
                    <th style="width: 35%;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.CategoryName</td>
                        <td class="text-end">$@category.Total.ToString("N2")</td>
                        <td class="text-end">@category.Percentage.ToString("0.#", CultureInfo.InvariantCulture)%</td>
                        <td>
                            <div class="progress" role="progressbar">
                                <div class="progress-bar" style="width: @category.Percentage.ToString("0.#", CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
