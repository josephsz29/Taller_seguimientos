@{
    ViewData["Title"] = "Jugar";
}

<h2 class="mb-1">Juego de Memoria</h2>
<p class="text-muted mb-4">
    Voltea las cartas de dos en dos y encuentra todas las parejas con el menor número de movimientos y el menor tiempo.
</p>

<h5 class="mb-3">Elige un nivel</h5>

<div class="row g-3 mb-4">
    @foreach (var setting in DifficultySettings.All)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@setting.Label</h5>
                    <p class="card-text text-muted">
                        @setting.Pairs parejas<br />
                        @setting.TotalCards cartas
                    </p>

                    <form asp-action="Start" method="post" class="mt-auto">
                        <input type="hidden" name="difficulty" value="@setting.Difficulty" />
                        <button type="submit" class="btn btn-primary w-100">Jugar</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<div class="card card-body bg-light">
    <h6>¿Cómo se calcula el puntaje?</h6>
    <p class="mb-0 small">
        Cada pareja vale 100 puntos. Se descuentan 10 puntos por cada movimiento de más
        (el mínimo posible es una pareja por movimiento) y 1 punto por cada segundo.
        Los mejores puntajes de cada nivel aparecen en el <a asp-action="Leaderboard">ranking</a>.
    </p>
</div>
