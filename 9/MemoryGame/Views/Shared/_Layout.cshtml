<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Juego de Memoria</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/memory.css" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Games" asp-action="Index">Juego de Memoria</a>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Games" asp-action="Index">Jugar</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Games" asp-action="Leaderboard">Ranking</a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="container" style="max-width: 820px;">
        @RenderBody()
    </main>
</body>
</html>
