@model TipViewModel
@{
    ViewData["Title"] = "Calcular propina";
    var percentages = new[] { 5, 10, 15, 18, 20, 25 };
}

<h2 class="mb-4">Calcular propina</h2>

<form asp-action="Index" method="post">
    <div class="mb-3">
        <label asp-for="BillAmount" class="form-label"></label>
        <input asp-for="BillAmount" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
        <span asp-validation-for="BillAmount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TipPercentage" class="form-label"></label>
        <select asp-for="TipPercentage" class="form-select">
            @foreach (var p in percentages)
            {
                <option value="@p" selected="@(Model.TipPercentage == p)">@p%</option>
            }
        </select>
        <span asp-validation-for="TipPercentage" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Calcular</button>
</form>

<!-- El resultado solo se dibuja después de calcular -->
@if (Model.Result != null)
{
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Resultado</h5>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span>Cuenta</span>
                    <strong>$@Model.BillAmount!.Value.ToString("N2")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span>Propina (@Model.TipPercentage%)</span>
                    <strong>$@Model.Result.TipAmount.ToString("N2")</strong>
                </li>
                <li class="list-group-item d-flex justify-content-between fs-5">
                    <span>Total a pagar</span>
                    <strong>$@Model.Result.TotalWithTip.ToString("N2")</strong>
                </li>
            </ul>
        </div>
    </div>
}

<!-- Historial guardado en la base de datos -->
<h4 class="mt-5">Historial reciente</h4>

@if (!Model.History.Any())
{
    <p class="text-muted">Aún no hay cálculos guardados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th class="text-end">Cuenta</th>
                    <th class="text-end">%</th>
                    <th class="text-end">Propina</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.History)
                {
                    <tr>
                        <td>@record.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">$@record.BillAmount.ToString("N2")</td>
                        <td class="text-end">@record.TipPercentage.ToString("0.##")%</td>
                        <td class="text-end">$@record.TipAmount.ToString("N2")</td>
                        <td class="text-end">$@record.TotalWithTip.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
