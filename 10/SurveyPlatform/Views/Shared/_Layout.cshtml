<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Plataforma de Encuestas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <!-- d-print-none: la barra no se imprime en los informes -->
    <nav class="navbar navbar-expand navbar-dark bg-dark mb-4 d-print-none">
        <div class="container">
            <a class="navbar-brand" asp-controller="Surveys" asp-action="Index">Plataforma de Encuestas</a>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Surveys" asp-action="Index">Mis encuestas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Surveys" asp-action="Create">Nueva encuesta</a>
                </li>
            </ul>
        </div>
    </nav>

    <main class="container" style="max-width: 900px;">
        @RenderBody()
    </main>
</body>
</html>
