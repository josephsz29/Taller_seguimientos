@model SurveyFormViewModel
@{
    // La misma vista sirve para crear (Id = 0) y para editar
    var isNew = Model.Id == 0;
    var formAction = isNew ? "Create" : "Edit";
    ViewData["Title"] = isNew ? "Nueva encuesta" : "Editar encuesta";
}

<a asp-action="Index" class="text-decoration-none">&larr; Mis encuestas</a>

<h2 class="mt-2 mb-4">@ViewData["Title"]</h2>

<form asp-action="@formAction" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" maxlength="150" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(isNew ? "Crear y agregar preguntas" : "Guardar")</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
