@model AnswerSurveyViewModel
@{
    ViewData["Title"] = Model.Title;
}

<h2 class="mb-1">@Model.Title</h2>

@if (!string.IsNullOrEmpty(Model.Description))
{
    <p class="text-muted">@Model.Description</p>
}

@if (Model.GeneralError != null)
{
    <div class="alert alert-danger">@Model.GeneralError</div>
}

@if (!Model.Questions.Any())
{
    <p class="text-muted">Esta encuesta todavía no tiene preguntas.</p>
}
else
{
    <form asp-action="Answer" method="post">
        <input type="hidden" asp-for="Code" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];

            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="mb-3">
                        @(i + 1). @question.Text
                        @if (question.IsRequired)
                        {
                            <span class="text-danger">*</span>
                        }
                    </h6>

                    <input type="hidden" name="Questions[@(i)].QuestionId" value="@question.QuestionId" />

                    @if (question.Type == QuestionType.SingleChoice)
                    {
                        @foreach (var option in question.Options)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio"
                                       id="q@(i)_o@(option.Id)"
                                       name="Questions[@(i)].SelectedOptionId"
                                       value="@option.Id"
                                       checked="@(question.SelectedOptionId == option.Id)" />
                                <label class="form-check-label" for="q@(i)_o@(option.Id)">@option.Text</label>
                            </div>
                        }
                    }
                    else if (question.Type == QuestionType.MultipleChoice)
                    {
                        @foreach (var option in question.Options)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       id="q@(i)_o@(option.Id)"
                                       name="Questions[@(i)].SelectedOptionIds"
                                       value="@option.Id"
                                       checked="@(question.SelectedOptionIds.Contains(option.Id))" />
                                <label class="form-check-label" for="q@(i)_o@(option.Id)">@option.Text</label>
                            </div>
                        }
                    }
                    else if (question.Type == QuestionType.Rating)
                    {
                        <div class="d-flex flex-wrap gap-3 align-items-center">
                            <span class="text-muted small">1 = muy mal</span>

                            @for (int rating = 1; rating <= 5; rating++)
                            {
                                <div class="form-check form-check-inline me-0">
                                    <input class="form-check-input" type="radio"
                                           id="q@(i)_r@(rating)"
                                           name="Questions[@(i)].RatingValue"
                                           value="@rating"
                                           checked="@(question.RatingValue == rating)" />
                                    <label class="form-check-label" for="q@(i)_r@(rating)">@rating</label>
                                </div>
                            }

                            <span class="text-muted small">5 = excelente</span>
                        </div>
                    }
                    else
                    {
                        <textarea name="Questions[@(i)].TextValue" class="form-control" rows="3"
                                  maxlength="1000">@question.TextValue</textarea>
                    }

                    @if (question.Error != null)
                    {
                        <div class="text-danger small mt-2">@question.Error</div>
                    }
                </div>
            </div>
        }

        <button type="submit" class="btn btn-primary">Enviar respuestas</button>
    </form>
}
