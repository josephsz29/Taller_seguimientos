@model SurveyBuilderViewModel
@{
    ViewData["Title"] = Model.Survey.Title;

    // Enlace público completo para compartir, por ejemplo https://localhost:7010/Surveys/Answer?code=AB12CD34
    var answerUrl = Url.Action("Answer", "Surveys", new { code = Model.Survey.ShareCode }, Context.Request.Scheme);
    var questions = Model.Survey.Questions.OrderBy(q => q.Position).ToList();
}

<a asp-action="Index" class="text-decoration-none">&larr; Mis encuestas</a>

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mt-2 mb-3">
    <div>
        <h2 class="mb-1">@Model.Survey.Title</h2>
        @if (!string.IsNullOrEmpty(Model.Survey.Description))
        {
            <p class="text-muted mb-0">@Model.Survey.Description</p>
        }
    </div>

    <div>
        @if (Model.Survey.IsOpen)
        {
            <span class="badge text-bg-success fs-6">Abierta</span>
        }
        else
        {
            <span class="badge text-bg-secondary fs-6">Cerrada</span>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Acciones de la encuesta -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Edit" asp-route-id="@Model.Survey.Id" class="btn btn-outline-primary">Editar título</a>
    <a asp-action="Results" asp-route-id="@Model.Survey.Id" class="btn btn-outline-success">
        Ver resultados (@Model.ResponseCount)
    </a>

    <form asp-action="ToggleOpen" asp-route-id="@Model.Survey.Id" method="post">
        <button type="submit" class="btn btn-outline-warning">
            @(Model.Survey.IsOpen ? "Cerrar encuesta" : "Abrir encuesta")
        </button>
    </form>

    <form asp-action="Delete" asp-route-id="@Model.Survey.Id" method="post"
          onsubmit="return confirm('¿Eliminar la encuesta con todas sus preguntas y respuestas?');">
        <button type="submit" class="btn btn-outline-danger">Eliminar encuesta</button>
    </form>
</div>

<!-- Enlace para compartir -->
<div class="card mb-4">
    <div class="card-body">
        <h6 class="card-title">Enlace para responder</h6>

        <div class="input-group">
            <input id="answerUrl" type="text" class="form-control" value="@answerUrl" readonly />
            <button id="copyButton" type="button" class="btn btn-outline-secondary" onclick="copyAnswerUrl()">Copiar enlace</button>
            <a href="@answerUrl" target="_blank" class="btn btn-outline-primary">Abrir</a>
        </div>

        <div class="form-text">Quien tenga este enlace puede responder la encuesta mientras esté abierta.</div>
    </div>
</div>

<!-- Preguntas -->
<h4 class="mb-3">Preguntas</h4>

@if (!Model.CanEditQuestions)
{
    <div class="alert alert-info">
        Esta encuesta ya tiene respuestas, así que las preguntas no se pueden agregar ni eliminar
        (los resultados quedarían inconsistentes).
    </div>
}

@if (!questions.Any())
{
    <p class="text-muted">Todavía no hay preguntas. Agrega la primera abajo.</p>
}
else
{
    <ol class="list-group list-group-numbered mb-4">
        @foreach (var question in questions)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <div class="ms-2 me-auto">
                    <div class="fw-semibold">
                        @question.Text
                        @if (question.IsRequired)
                        {
                            <span class="text-danger">*</span>
                        }
                    </div>
                    <div class="small text-muted">@question.Type.ToLabel()</div>

                    @if (question.Options.Any())
                    {
                        <div class="mt-1">
                            @foreach (var option in question.Options.OrderBy(o => o.Position))
                            {
                                <span class="badge text-bg-light border">@option.Text</span>
                            }
                        </div>
                    }
                </div>

                @if (Model.CanEditQuestions)
                {
                    <form asp-action="DeleteQuestion" method="post"
                          onsubmit="return confirm('¿Eliminar esta pregunta?');">
                        <input type="hidden" name="id" value="@question.Id" />
                        <input type="hidden" name="surveyId" value="@Model.Survey.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                    </form>
                }
            </li>
        }
    </ol>
}

<!-- Agregar pregunta -->
@if (Model.CanEditQuestions)
{
    <div class="card mb-5">
        <div class="card-body">
            <h5 class="card-title">Agregar pregunta</h5>

            <form asp-action="AddQuestion" method="post">
                <input type="hidden" asp-for="NewQuestion.SurveyId" />

                <div class="mb-3">
                    <label asp-for="NewQuestion.Text" class="form-label"></label>
                    <input asp-for="NewQuestion.Text" class="form-control" maxlength="300" />
                    <span asp-validation-for="NewQuestion.Text" class="text-danger"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="NewQuestion.Type" class="form-label"></label>
                        <select asp-for="NewQuestion.Type" id="questionType" class="form-select">
                            @foreach (var type in Enum.GetValues<QuestionType>())
                            {
                                <option value="@type" selected="@(Model.NewQuestion.Type == type)">@type.ToLabel()</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="NewQuestion.IsRequired" class="form-check-input" />
                            <label asp-for="NewQuestion.IsRequired" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <!-- Las opciones solo se piden en preguntas de opción única o múltiple -->
                <div id="optionsGroup" class="mb-3">
                    <label asp-for="NewQuestion.OptionsText" class="form-label"></label>
                    <textarea asp-for="NewQuestion.OptionsText" class="form-control" rows="4"
                              placeholder="Excelente&#10;Bueno&#10;Regular&#10;Malo"></textarea>
                    <span asp-validation-for="NewQuestion.OptionsText" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Agregar pregunta</button>
            </form>
        </div>
    </div>
}

<script>
    // Copia el enlace al portapapeles y avisa brevemente en el botón
    function copyAnswerUrl() {
        const input = document.getElementById('answerUrl');
        const button = document.getElementById('copyButton');

        navigator.clipboard.writeText(input.value).then(function () {
            button.textContent = '¡Copiado!';
            setTimeout(function () { button.textContent = 'Copiar enlace'; }, 1500);
        });
    }

    // Muestra u oculta el cuadro de opciones según el tipo de pregunta
    (function () {
        const typeSelect = document.getElementById('questionType');
        const optionsGroup = document.getElementById('optionsGroup');

        if (!typeSelect || !optionsGroup) {
            return;
        }

        function updateOptionsGroup() {
            const hasOptions = typeSelect.value === 'SingleChoice' || typeSelect.value === 'MultipleChoice';
            optionsGroup.classList.toggle('d-none', !hasOptions);
        }

        typeSelect.addEventListener('change', updateOptionsGroup);
        updateOptionsGroup();
    })();
</script>
