@using System.Globalization
@model List<BookableService>
@{
    ViewData["Title"] = "Servicios";
    var colombia = CultureInfo.GetCultureInfo("es-CO");
}

<h2 class="mb-1">Reserva tu cita</h2>
<p class="text-muted mb-4">
    Atendemos de lunes a viernes, de @BookingRules.OpeningLabel a @BookingRules.ClosingLabel.
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Servicios disponibles -->
<div class="row g-3 mb-5">
    @foreach (var service in Model)
    {
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@service.Name</h5>
                    <p class="card-text text-muted">@service.Description</p>
                    <p class="mb-3">
                        <span class="badge text-bg-light border">@service.DurationMinutes min</span>
                        <strong class="ms-2">$@service.Price.ToString("N0", colombia)</strong>
                    </p>
                    <a asp-action="Slots" asp-route-serviceId="@service.Id" class="btn btn-primary mt-auto">Ver horarios</a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Consultar una reserva con su código -->
<h5>¿Ya tienes una reserva?</h5>
<form asp-action="Details" method="get" class="d-flex gap-2">
    <input type="text" name="code" class="form-control text-uppercase" placeholder="Código de reserva" maxlength="10" />
    <button type="submit" class="btn btn-outline-secondary">Consultar</button>
</form>
