@model RecipeFormViewModel
@{
    // La misma vista sirve para crear (Id = 0) y para editar
    var isNew = Model.Id == 0;
    var formAction = isNew ? "Create" : "Edit";
    ViewData["Title"] = isNew ? "Nueva receta" : "Editar receta";
}

<a asp-action="Index" class="text-decoration-none">&larr; Todas las recetas</a>

<h2 class="mt-2 mb-4">@ViewData["Title"]</h2>

<form asp-action="@formAction" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" maxlength="150" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2" maxlength="500"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label asp-for="FoodTypeId" class="form-label"></label>
            <select asp-for="FoodTypeId" asp-items="Model.FoodTypes" class="form-select">
                <option value="0">Selecciona...</option>
            </select>
            <span asp-validation-for="FoodTypeId" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="PrepTimeMinutes" class="form-label"></label>
            <input asp-for="PrepTimeMinutes" type="number" min="1" max="1440" class="form-control" />
            <span asp-validation-for="PrepTimeMinutes" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="Servings" class="form-label"></label>
            <input asp-for="Servings" type="number" min="1" max="100" class="form-control" />
            <span asp-validation-for="Servings" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="IngredientsText" class="form-label"></label>
        <textarea asp-for="IngredientsText" class="form-control" rows="6"
                  placeholder="2 tazas de harina&#10;3 huevos&#10;1 pizca de sal"></textarea>
        <div class="form-text">Escribe un ingrediente por línea. Así podrás buscar recetas por ingrediente.</div>
        <span asp-validation-for="IngredientsText" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Instructions" class="form-label"></label>
        <textarea asp-for="Instructions" class="form-control" rows="8"></textarea>
        <span asp-validation-for="Instructions" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
