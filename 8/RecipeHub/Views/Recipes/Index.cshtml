@model RecipeIndexViewModel
@{
    ViewData["Title"] = "Recetas";

    // Dirección actual (con los filtros) para volver aquí después de guardar una favorita
    var returnUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;

    // Muestra solo el inicio de la descripción en las tarjetas
    string Excerpt(string? text) =>
        string.IsNullOrEmpty(text) ? "" : (text.Length <= 110 ? text : text.Substring(0, 110) + "...");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Recetas</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva receta</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Búsqueda y filtros (se envían por GET para que la URL se pueda guardar o compartir) -->
<form asp-action="Index" method="get" class="card card-body mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label small mb-1">Buscar</label>
            <input type="text" name="Search" value="@Model.Filter.Search" class="form-control"
                   placeholder="Nombre o descripción..." />
        </div>

        <div class="col-md-4">
            <label class="form-label small mb-1">Ingredientes (separados por coma)</label>
            <input type="text" name="Ingredients" value="@Model.Filter.Ingredients" class="form-control"
                   placeholder="Ej: huevo, harina" />
        </div>

        <div class="col-md-2">
            <label class="form-label small mb-1">Tipo de comida</label>
            <select name="FoodTypeId" class="form-select">
                <option value="">Todos</option>
                @foreach (var item in Model.FoodTypes)
                {
                    <option value="@item.Value" selected="@(Model.Filter.FoodTypeId.ToString() == item.Value)">@item.Text</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small mb-1">Tiempo máximo</label>
            <select name="MaxPrepTime" class="form-select">
                <option value="">Cualquiera</option>
                <option value="15" selected="@(Model.Filter.MaxPrepTime == 15)">15 min</option>
                <option value="30" selected="@(Model.Filter.MaxPrepTime == 30)">30 min</option>
                <option value="60" selected="@(Model.Filter.MaxPrepTime == 60)">1 hora</option>
                <option value="120" selected="@(Model.Filter.MaxPrepTime == 120)">2 horas</option>
            </select>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="form-check">
            <input type="checkbox" id="OnlyFavorites" name="OnlyFavorites" value="true"
                   class="form-check-input" checked="@Model.Filter.OnlyFavorites" />
            <label for="OnlyFavorites" class="form-check-label">Solo favoritas</label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            @if (Model.Filter.HasFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar filtros</a>
            }
        </div>
    </div>
</form>

<p class="text-muted">@Model.Recipes.Count receta(s) encontrada(s)</p>

@if (!Model.Recipes.Any())
{
    <p class="text-muted">
        No hay recetas para mostrar.
        @if (!Model.Filter.HasFilters)
        {
            <a asp-action="Create">Agrega la primera.</a>
        }
    </p>
}
else
{
    <div class="row g-3">
        @foreach (var recipe in Model.Recipes)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                <a asp-action="Details" asp-route-id="@recipe.Id" class="text-decoration-none">@recipe.Title</a>
                            </h5>

                            <!-- Guardar / quitar de favoritas -->
                            <form asp-action="ToggleFavorite" asp-route-id="@recipe.Id" method="post">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-sm btn-link text-warning p-0 fs-4"
                                        title="@(recipe.IsFavorite ? "Quitar de favoritas" : "Guardar en favoritas")">
                                    @(recipe.IsFavorite ? "★" : "☆")
                                </button>
                            </form>
                        </div>

                        <div class="mb-2">
                            <span class="badge text-bg-secondary">@recipe.FoodType.Name</span>
                            <span class="badge text-bg-light border">@recipe.PrepTimeMinutes min</span>
                            <span class="badge text-bg-light border">@recipe.Servings porciones</span>
                        </div>

                        <p class="card-text text-muted mb-0">@Excerpt(recipe.Description)</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
