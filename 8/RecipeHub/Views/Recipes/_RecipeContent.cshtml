@model Recipe

<!-- Contenido de la receta: lo usan la página de detalle y la página para compartir -->
<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h2 class="mb-0">@Model.Title</h2>
            @if (Model.IsFavorite)
            {
                <span class="text-warning fs-3" title="Favorita">★</span>
            }
        </div>

        <div class="mb-3">
            <span class="badge text-bg-secondary">@Model.FoodType.Name</span>
            <span class="badge text-bg-light border">@Model.PrepTimeMinutes min</span>
            <span class="badge text-bg-light border">@Model.Servings porciones</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }

        <h5 class="mt-4">Ingredientes</h5>
        <ul>
            @foreach (var ingredient in Model.Ingredients.OrderBy(i => i.Id))
            {
                <li>@ingredient.Description</li>
            }
        </ul>

        <h5 class="mt-4">Preparación</h5>
        <!-- pre-wrap respeta los saltos de línea que escribió el usuario; Razor escapa el HTML automáticamente -->
        <p style="white-space: pre-wrap;">@Model.Instructions</p>

        <hr />
        <small class="text-muted">Publicada el @Model.CreatedAt.ToString("dd/MM/yyyy")</small>
    </div>
</div>
