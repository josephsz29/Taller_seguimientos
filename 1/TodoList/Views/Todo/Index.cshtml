@model List<TodoList.Models.TodoItem>
@{
    ViewData["Title"] = "Lista de Tareas";
}

<h2 class="mb-4">Mis tareas</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Formulario para agregar una tarea -->
<form asp-action="Create" method="post" class="d-flex gap-2 mb-4">
    <input type="text" name="title" class="form-control" placeholder="Nueva tarea..." maxlength="200" />
    <button type="submit" class="btn btn-primary">Agregar</button>
</form>

<!-- Lista de tareas -->
@if (!Model.Any())
{
    <p class="text-muted">No hay tareas. ¡Agrega la primera!</p>
}
else
{
    <ul class="list-group">
        @foreach (var item in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span class="@(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                    @item.Title
                </span>

                <div class="d-flex gap-2">
                    <form asp-action="Toggle" asp-route-id="@item.Id" method="post">
                        <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-warning" : "btn-success")">
                            @(item.IsCompleted ? "Reabrir" : "Completar")
                        </button>
                    </form>

                    <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                          onsubmit="return confirm('¿Eliminar esta tarea?');">
                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                    </form>
                </div>
            </li>
        }
    </ul>
}
