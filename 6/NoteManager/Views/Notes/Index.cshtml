@model NoteIndexViewModel
@{
    ViewData["Title"] = "Notas";

    // Muestra solo el inicio del contenido en la lista
    string Excerpt(string text) => text.Length <= 160 ? text : text.Substring(0, 160) + "...";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Mis notas</h2>
    <a asp-action="Create" class="btn btn-primary">Nueva nota</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<!-- Búsqueda y filtro por categoría -->
<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Buscar en título o contenido..." />
    </div>
    <div class="col-md-4">
        <select name="categoryId" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (var item in Model.Categories)
            {
                <option value="@item.Value" selected="@(Model.CategoryId.ToString() == item.Value)">@item.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary flex-fill">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar">&times;</a>
    </div>
</form>

<p class="text-muted">
    @Model.Notes.Count nota(s) encontrada(s)
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <span>para <strong>@Model.Search</strong></span>
    }
</p>

@if (!Model.Notes.Any())
{
    <p class="text-muted">No hay notas para mostrar.</p>
}
else
{
    <div class="row g-3">
        @foreach (var note in Model.Notes)
        {
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">
                                <a asp-action="Details" asp-route-id="@note.Id" class="text-decoration-none">@note.Title</a>
                            </h5>
                            <span class="badge text-bg-secondary">@note.Category.Name</span>
                        </div>

                        <p class="card-text text-muted" style="white-space: pre-line;">@Excerpt(note.Content)</p>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <small class="text-muted">@note.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</small>

                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary">Editar</a>

                                <form asp-action="Delete" asp-route-id="@note.Id" method="post"
                                      onsubmit="return confirm('¿Eliminar esta nota?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
